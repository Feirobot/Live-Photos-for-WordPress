{
  "name": "live-photo-component",
  "version": "1.2.1",
  "description": "Play and detect Live Photos in the browser: zero-dependency Web Component for Apple Live Photos and Android Motion Photos (photo + video, native HTML5).",
  "type": "module",
  "main": "dist/live-photo.umd.js",
  "module": "dist/live-photo.mjs",
  "browser": "dist/live-photo.umd.js",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "import": "./dist/live-photo.mjs",
      "require": "./dist/live-photo.umd.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepare": "npm run build",
    "dev": "rollup -c -w",
    "demo": "npx serve . -p 3000",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feirobot/live-photo-component.git"
  },
  "keywords": [
    "live-photo",
    "livephoto",
    "live-photos",
    "motion-photo",
    "apple-live-photo",
    "android-motion-photo",
    "web-component",
    "custom-element",
    "apple",
    "photo",
    "video",
    "html5",
    "heic",
    "mov",
    "livp",
    "uploader",
    "detection",
    "zero-dependencies",
    "wechat",
    "wordpress"
  ],
  "author": "Feiro <Feirobot@gmail.com>",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/Feirobot/live-photo-component/issues"
  },
  "homepage": "https://github.com/Feirobot/live-photo-component#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.9.0"
  }
}
