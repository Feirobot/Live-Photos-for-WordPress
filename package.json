{
  "name": "live-photo-component",
  "version": "1.0.0",
  "description": "Apple-style Live Photo Web Component. Zero dependencies, native HTML5.",
  "type": "module",
  "main": "dist/live-photo.umd.js",
  "module": "dist/live-photo.mjs",
  "browser": "dist/live-photo.umd.js",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "import": "./dist/live-photo.mjs",
      "require": "./dist/live-photo.umd.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepare": "npm run build",
    "dev": "rollup -c -w",
    "demo": "npx serve demo -p 3000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feirobot/live-photo-component.git"
  },
  "keywords": [
    "live-photo",
    "live-photos",
    "web-component",
    "apple",
    "photo",
    "video",
    "html5",
    "custom-element"
  ],
  "author": "Feiro <Feirobot@gmail.com>",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/Feirobot/live-photo-component/issues"
  },
  "homepage": "https://github.com/Feirobot/live-photo-component#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.9.0"
  }
}